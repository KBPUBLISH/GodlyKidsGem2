PORT=5001
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
GCS_BUCKET_NAME=your-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# Secret used to sign/verify every JWT (app users, admins, creators, churches).
# REQUIRED — the server refuses to start without it, there is no default.
# Generate one with: openssl rand -hex 32
# In production set it in the Render dashboard, never commit the real value.
# Rotating it invalidates all existing sessions (everyone must log in again).
JWT_SECRET=generate-with-openssl-rand-hex-32

# Comma-separated list of email addresses that get admin portal access (and that
# cannot be deleted from the dashboard or by self-service account deletion).
# REQUIRED — there is no default list. Registration is open and unverified, so a
# hard-coded fallback would mean anyone could register the address and be admin.
# Matched case-insensitively; surrounding whitespace is ignored.
# If unset the server still starts but NO account is an admin, which means you
# cannot log into the admin portal until you set it.
ADMIN_EMAILS=admin@example.com,support@example.com

# Anthropic Claude — AI Insights + Bible Map quiz assist
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional overrides if Anthropic ships new model IDs (defaults shown)
ANTHROPIC_MODEL_OPUS=claude-opus-5
ANTHROPIC_MODEL_SONNET=claude-sonnet-5
# Optional: Bible Map reading-level generation (defaults to ANTHROPIC_MODEL_OPUS)
# ANTHROPIC_READING_MODEL=claude-opus-5
# Optional: quiz assist model (defaults to ANTHROPIC_MODEL_SONNET)
# ANTHROPIC_QUIZ_MODEL=claude-sonnet-5
