PORT=5001
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
GCS_BUCKET_NAME=your-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# Anthropic Claude — AI Insights + Bible Map quiz assist
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional overrides if Anthropic ships new model IDs (defaults shown)
ANTHROPIC_MODEL_OPUS=claude-opus-5
ANTHROPIC_MODEL_SONNET=claude-sonnet-5
# Optional: Bible Map reading-level generation (defaults to ANTHROPIC_MODEL_OPUS)
# ANTHROPIC_READING_MODEL=claude-opus-5
# Optional: quiz assist model (defaults to ANTHROPIC_MODEL_SONNET)
# ANTHROPIC_QUIZ_MODEL=claude-sonnet-5
