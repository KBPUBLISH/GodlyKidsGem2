# Auth routes live under /api (e.g. /api/authentication/sign-in). Include /api in the base URL.
# Copy to .env.local for local preview/dev (Vite bakes these at build time).
# Production default in source is https://backendgk2-0.onrender.com when unset.
VITE_API_BASE_URL=http://127.0.0.1:5001/api/
VITE_API_URL=http://127.0.0.1:5001/api/
